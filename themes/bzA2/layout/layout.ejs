<!DOCTYPE html>
<html lang="zh_CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- favicon_tag('img/favicon.jpg') %>
    <title><%= page.title ? `${page.title} | \\(z_Z)/` : '博客 | \\(z_Z)/' %></title>
    <%- css('css/global.css') %>
    <%- css('css/blog.css') %>
    <%- css('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css') %>
    <%- js('https://cdnjs.cloudflare.com/ajax/libs/jquery/4.0.0/jquery.min.js') %>
</head>
<body>
    <%- partial('partial/noscript') %>
    <%- partial('partial/menu') %>
    <div id="blog_content">
        <%- body %>
    </div>
</body>
<%- js('js/theme.js') %>
<%- js('js/menu.js') %>
</html>